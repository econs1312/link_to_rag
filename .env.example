# Environment & App Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=link_to_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/link_to_rag

# Redis / ARQ Queue Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Extraction API Tokens & Proxies
OPENAI_API_KEY=your-openai-api-key
JINA_API_KEY=
APIFY_API_TOKEN=
PROXY_URL=

# RAG & Chunking Config
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MODEL=text-embedding-3-small
